{
  "openapi": "3.1.0",
  "info": {
    "title": "Opteryx Policy Service",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/access/workspace/{workspace}": {
      "get": {
        "tags": [
          "Access Control"
        ],
        "summary": "List workspace policies",
        "description": "Get all access policies for a workspace. Requires owner or admin access.",
        "operationId": "list_workspace_policies_v1_access_workspace__workspace__get",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacePoliciesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/access/workspace/{workspace}/effective-permissions.csv": {
      "get": {
        "tags": [
          "Access Control"
        ],
        "summary": "Export effective permissions",
        "description": "Export a CSV of who has access to every dataset and view in the workspace, resolving each policy's pattern against the workspace's actual catalog. A policy scoped to a wildcard pattern appears on one row per dataset it covers, so the same policy_id can repeat across many rows. Owner-only: this is a full map of who can reach every resource in the workspace, not a single grant.",
        "operationId": "export_effective_permissions_v1_access_workspace__workspace__effective_permissions_csv_get",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV export of effective permissions.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/access/workspace/{workspace}/policies/{policy_id}": {
      "get": {
        "tags": [
          "Access Control"
        ],
        "summary": "Get policy details",
        "description": "Get detailed information about a specific policy.",
        "operationId": "get_policy_v1_access_workspace__workspace__policies__policy_id__get",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Policy ID",
              "title": "Policy Id"
            },
            "description": "Policy ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Access Control"
        ],
        "summary": "Update policy",
        "description": "Update an existing access policy.",
        "operationId": "update_policy_v1_access_workspace__workspace__policies__policy_id__put",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Policy ID",
              "title": "Policy Id"
            },
            "description": "Policy ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePolicyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Update Policy V1 Access Workspace  Workspace  Policies  Policy Id  Put"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Access Control"
        ],
        "summary": "Delete policy",
        "description": "Remove an access policy from the workspace.",
        "operationId": "delete_policy_v1_access_workspace__workspace__policies__policy_id__delete",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Policy ID",
              "title": "Policy Id"
            },
            "description": "Policy ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Delete Policy V1 Access Workspace  Workspace  Policies  Policy Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/access/workspace/{workspace}/policies": {
      "post": {
        "tags": [
          "Access Control"
        ],
        "summary": "Create policy",
        "description": "Create a new access policy for a user in the workspace.",
        "operationId": "create_policy_v1_access_workspace__workspace__policies_post",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePolicyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePolicyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/access/workspace/{workspace}/genesis": {
      "post": {
        "tags": [
          "Access Control"
        ],
        "summary": "Bootstrap a new workspace's initial policies",
        "description": "Create the initial set of access policies for a brand-new workspace, one policy per {identity, role} pair, each scoped to the whole workspace (pattern `{workspace}.*`). This is a trusted bootstrap operation for whatever creates the workspace record in the first place (e.g. billing.opteryx's workspace-create endpoint) to hand it an explicit member list at creation time, rather than every caller becoming sole owner. Refuses with 409 if the workspace already has any policy at all -- this can only be used once, to bootstrap a workspace that doesn't have policies yet, not to add owners to one that already does.",
        "operationId": "create_genesis_policies_v1_access_workspace__workspace__genesis_post",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Workspace name",
              "title": "Workspace"
            },
            "description": "Workspace name"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenesisGrantRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenesisGrantResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePolicyRequest": {
        "properties": {
          "principal": {
            "$ref": "#/components/schemas/Principal",
            "description": "User to grant access to"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "writer",
              "reader"
            ],
            "title": "Role",
            "description": "Role to grant. See [Security & Permissions](/docs/core-concepts/access-and-permissions) for what each role can do."
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern (e.g., 'analytics.*')"
          }
        },
        "type": "object",
        "required": [
          "principal",
          "role",
          "pattern"
        ],
        "title": "CreatePolicyRequest",
        "description": "Request to create a new policy."
      },
      "CreatePolicyResponse": {
        "properties": {
          "policy": {
            "type": "string",
            "title": "Policy",
            "description": "ID of the created policy"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Success message"
          }
        },
        "type": "object",
        "required": [
          "policy",
          "message"
        ],
        "title": "CreatePolicyResponse",
        "description": "Response after creating a policy."
      },
      "GenesisGrant": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity",
            "description": "User identity to grant access to"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "writer",
              "reader"
            ],
            "title": "Role",
            "description": "Role to grant. See [Security & Permissions](/docs/core-concepts/access-and-permissions) for what each role can do."
          }
        },
        "type": "object",
        "required": [
          "identity",
          "role"
        ],
        "title": "GenesisGrant",
        "description": "One identity/role pair to grant when bootstrapping a brand-new workspace."
      },
      "GenesisGrantRequest": {
        "properties": {
          "grants": {
            "items": {
              "$ref": "#/components/schemas/GenesisGrant"
            },
            "type": "array",
            "minItems": 1,
            "title": "Grants",
            "description": "Identity/role pairs to grant over the whole workspace"
          }
        },
        "type": "object",
        "required": [
          "grants"
        ],
        "title": "GenesisGrantRequest",
        "description": "Request to create the initial set of policies for a brand-new workspace.\n\nUnlike `CreatePolicyRequest`, there's no single `pattern` on the request --\nevery grant is scoped to the whole workspace (`{workspace}.*`) by the route\nitself, since this is about establishing who owns/administers the workspace\nas a whole at creation time, not granting access to one resource within it."
      },
      "GenesisGrantResponse": {
        "properties": {
          "policies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Policies",
            "description": "IDs of the created policy documents, one per grant"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Success message"
          }
        },
        "type": "object",
        "required": [
          "policies",
          "message"
        ],
        "title": "GenesisGrantResponse",
        "description": "Response after bootstrapping a new workspace's initial policies."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PolicyDetail": {
        "properties": {
          "principal": {
            "$ref": "#/components/schemas/Principal",
            "description": "User this policy applies to"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "writer",
              "reader"
            ],
            "title": "Role",
            "description": "Role granted. See [Security & Permissions](/docs/core-concepts/access-and-permissions) for what each role can do."
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "When the policy was created (ISO format)"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "When the policy was last updated (ISO format)"
          },
          "updated_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Principal"
              },
              {
                "type": "null"
              }
            ],
            "description": "Who last updated the policy"
          }
        },
        "type": "object",
        "required": [
          "principal",
          "role",
          "pattern"
        ],
        "title": "PolicyDetail",
        "description": "Detailed information about a specific policy."
      },
      "PolicyInfo": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity",
            "description": "User identity this policy applies to"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "writer",
              "reader"
            ],
            "title": "Role",
            "description": "Role granted. See [Security & Permissions](/docs/core-concepts/access-and-permissions) for what each role can do."
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern (e.g., 'analytics.*', 'analytics.sales.*')"
          },
          "policy": {
            "type": "string",
            "title": "Policy",
            "description": "Policy document ID"
          }
        },
        "type": "object",
        "required": [
          "identity",
          "role",
          "pattern",
          "policy"
        ],
        "title": "PolicyInfo",
        "description": "Information about a single policy."
      },
      "Principal": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity",
            "description": "User identity (e.g., username, email, subject)"
          }
        },
        "type": "object",
        "required": [
          "identity"
        ],
        "title": "Principal",
        "description": "Represents a principal (user) in a policy."
      },
      "UpdatePolicyRequest": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "writer",
              "reader"
            ],
            "title": "Role",
            "description": "Updated role. See [Security & Permissions](/docs/core-concepts/access-and-permissions) for what each role can do."
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Updated resource pattern"
          }
        },
        "type": "object",
        "required": [
          "role",
          "pattern"
        ],
        "title": "UpdatePolicyRequest",
        "description": "Request to update an existing policy.\n\nNote this carries no `principal`, so the wildcard rule cannot be enforced here —\nan update could otherwise widen the pattern of an existing wildcard-principal\npolicy. The route checks it against the stored principal instead."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspacePoliciesResponse": {
        "properties": {
          "principals": {
            "items": {
              "$ref": "#/components/schemas/PolicyInfo"
            },
            "type": "array",
            "title": "Principals",
            "description": "List of policies"
          }
        },
        "type": "object",
        "required": [
          "principals"
        ],
        "title": "WorkspacePoliciesResponse",
        "description": "Response with all policies for a workspace."
      }
    }
  }
}