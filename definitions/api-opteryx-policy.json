  "components": {
    "schemas": {
      "CostPolicyRequest": {
        "properties": {
          "collection": {
            "type": "string",
            "title": "Collection",
            "description": "Collection the policy applies to"
          },
          "budget_limit": {
            "type": "number",
            "title": "Budget Limit",
            "description": "Budget limit for the collection"
          },
          "window": {
            "type": "string",
            "title": "Window",
            "description": "Time window for the budget (e.g., calendar_month)"
          },
          "violation_action": {
            "type": "string",
            "title": "Violation Action",
            "description": "Action to take on violation (e.g., block)"
          },
          "warn_at": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Warn At",
            "description": "Warning thresholds as percentages"
          }
        },
        "type": "object",
        "required": [
          "collection",
          "budget_limit",
          "window",
          "violation_action",
          "warn_at"
        ],
        "title": "CostPolicyRequest",
        "description": "Represents a cost policy for a workspace."
      },
      "CreatePolicyRequest": {
        "properties": {
          "principal": {
            "$ref": "#/components/schemas/Principal",
            "description": "User to grant access to"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role to grant (e.g., 'owner', 'reader', 'writer')"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern (e.g., 'analytics.*')"
          }
        },
        "type": "object",
        "required": [
          "principal",
          "role",
          "pattern"
        ],
        "title": "CreatePolicyRequest",
        "description": "Request to create a new policy."
      },
      "CreatePolicyResponse": {
        "properties": {
          "policy": {
            "type": "string",
            "title": "Policy",
            "description": "ID of the created policy"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Success message"
          }
        },
        "type": "object",
        "required": [
          "policy",
          "message"
        ],
        "title": "CreatePolicyResponse",
        "description": "Response after creating a policy."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PolicyDetail": {
        "properties": {
          "principal": {
            "$ref": "#/components/schemas/Principal",
            "description": "User this policy applies to"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role granted"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "When the policy was created (ISO format)"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "When the policy was last updated (ISO format)"
          },
          "updated_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Principal"
              },
              {
                "type": "null"
              }
            ],
            "description": "Who last updated the policy"
          }
        },
        "type": "object",
        "required": [
          "principal",
          "role",
          "pattern"
        ],
        "title": "PolicyDetail",
        "description": "Detailed information about a specific policy."
      },
      "PolicyInfo": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity",
            "description": "User identity this policy applies to"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role granted (e.g., 'owner', 'reader', 'writer')"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Resource pattern (e.g., 'analytics.*', 'analytics.sales.*')"
          },
          "policy": {
            "type": "string",
            "title": "Policy",
            "description": "Policy document ID"
          }
        },
        "type": "object",
        "required": [
          "identity",
          "role",
          "pattern",
          "policy"
        ],
        "title": "PolicyInfo",
        "description": "Information about a single policy."
      },
      "PolicyStoredResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Result message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "PolicyStoredResponse",
        "description": "Generic response for stored policy documents."
      },
      "Principal": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity",
            "description": "User identity (e.g., username, email, subject)"
          }
        },
        "type": "object",
        "required": [
          "identity"
        ],
        "title": "Principal",
        "description": "Represents a principal (user) in a policy."
      },
      "UpdatePolicyRequest": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Updated role"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern",
            "description": "Updated resource pattern"
          }
        },
        "type": "object",
        "required": [
          "role",
          "pattern"
        ],
        "title": "UpdatePolicyRequest",
        "description": "Request to update an existing policy."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspacePoliciesResponse": {
        "properties": {
          "principals": {
            "items": {
              "$ref": "#/components/schemas/PolicyInfo"
            },
            "type": "array",
            "title": "Principals",
            "description": "List of policies"
          }
        },
        "type": "object",
        "required": [
          "principals"
        ],
        "title": "WorkspacePoliciesResponse",
