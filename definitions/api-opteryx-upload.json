            "title": "Files Created"
          }
        },
        "type": "object",
        "required": [
          "table",
          "commit_id",
          "rows_written",
          "files_created"
        ],
        "title": "CommitResponse"
      },
      "ConflictResolution": {
        "type": "string",
        "enum": [
          "fail",
          "overwrite",
          "append"
