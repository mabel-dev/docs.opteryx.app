    "/v1/accounts/{account_id}/members/{identity}/accept": {
      "post": {
        "summary": "Accept Invite",
        "description": "Invitee (authenticated as `{identity}`) flips `pending` -> `active`.\n\nStamps `added_at`/`min_age_ms`/`eligible_at` at acceptance time -\n`min_age_ms` is read fresh from the account doc *now*, not from\nwhatever was on the invite, per api-v2.md's \"snapshot at accept time\"\nbehavior. 410 if the invite has expired; 404 if there's no pending\ninvite for this identity on this account.",
        "operationId": "accept_invite_v1_accounts__account_id__members__identity__accept_post",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
