    "/v1/accounts/{account_id}/payments": {
      "post": {
        "summary": "Create Payment",
        "description": "Ad hoc charge against the account's attached payment method.\n\n400 if no payment method is attached. A real `PaymentIntent` is created\nand confirmed synchronously against the attached Stripe payment method\nid - this moves real money, so this deliberately does not fake a\nsuccessful response; a Stripe failure surfaces as 402.",
        "operationId": "create_payment_v1_accounts__account_id__payments_post",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
