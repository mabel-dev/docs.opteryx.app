    "/v1/accounts/{account_id}/members": {
      "post": {
        "summary": "Invite Member",
        "description": "Invite a new member. Only existing billing_admins of this account may invite.\n\n409 if the invitee already has an active/pending membership on another\naccount (checked via the collection-group `find_existing_membership`\nquery). Re-inviting an identity that's still `pending` *on this same\naccount* resets the 7-day clock instead of erroring - a fresh\n`new_member_doc` is written over the existing pending doc.",
        "operationId": "invite_member_v1_accounts__account_id__members_post",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
