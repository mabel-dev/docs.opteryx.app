    "/api/v1/jobs/{identifier}/results": {
      "get": {
        "tags": [
          "Jobs Management"
        ],
        "summary": "Get job results",
        "description": "Retrieve the results of a previously submitted job.",
        "operationId": "get_job_results_api_v1_jobs__identifier__results_get",
