              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{identifier}/download": {
      "get": {
        "tags": [
          "Jobs Management"
        ],
        "summary": "Download job results",
        "description": "Download the results of a previously submitted job as CSV or JSON lines.",
        "operationId": "download_job_api_v1_jobs__identifier__download_get",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          },
          {
            "name": "file_format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "csv",
                "json"
              ],
              "type": "string",
              "default": "csv",
              "title": "File Format"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10000,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
