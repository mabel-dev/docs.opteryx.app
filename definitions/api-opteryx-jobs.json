            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{identifier}/download": {
      "get": {
        "tags": [
          "Jobs Management"
        ],
        "summary": "Download job results",
        "description": "Download the results of a previously submitted job as CSV, newline-delimited JSON, or Parquet.",
        "operationId": "download_job_api_v1_jobs__identifier__download_get",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          },
          {
            "name": "file_format",
            "in": "query",
