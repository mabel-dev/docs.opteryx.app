          }
        }
      }
    },
    "/api/v1/jobs/{identifier}/cancel": {
      "post": {
        "tags": [
          "Jobs Management"
        ],
        "summary": "Cancel job execution",
        "description": "Cancel a running job.",
        "operationId": "cancel_job_api_v1_jobs__identifier__cancel_post",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCancelResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
