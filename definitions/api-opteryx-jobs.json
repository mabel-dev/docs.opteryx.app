  "components": {
    "schemas": {
      "CheckedColumn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "nullable": {
            "type": "boolean",
            "title": "Nullable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "CheckedColumn",
        "description": "One column, as the check resolved it.\n\n`type` is the canonical SQL spelling — the same text a stored schema persists and\n`SHOW COLUMNS` prints, so an editor showing it beside a completion is showing\nsomething the reader can also type."
      },
      "CheckedIdentity": {
        "properties": {
          "identity": {
            "type": "string",
            "title": "Identity"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "'relation' or 'column'"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source",
            "description": "For a column, the relation qualifying it; None if computed here"
          },
          "data_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Type",
            "description": "The column's SQL type; None for relations"
          }
        },
        "type": "object",
        "required": [
          "identity",
          "type",
          "definition"
        ],
        "title": "CheckedIdentity",
        "description": "One name the statement makes available, and what it stands for.\n\nThis is the completion vocabulary: after `FROM sales.orders AS o`, `o` is a name\nthe reader can type; after `COUNT(*) AS n`, so is `n`."
      },
      "CheckedRelation": {
        "properties": {
          "alias": {
            "type": "string",
            "title": "Alias"
          },
          "relation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relation"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/CheckedColumn"
            },
            "type": "array",
            "title": "Columns"
          }
        },
        "type": "object",
        "required": [
          "alias"
        ],
        "title": "CheckedRelation",
        "description": "A relation in scope, under the name the statement refers to it by.\n\n`alias` is what qualifies a column here (`p` in `FROM $planets AS p`); `relation`\nis what it actually is. `columns` is the FULL column list, not just the ones the\nstatement referenced — completion needs the ones it did not."
      },
      "ErrorPosition": {
        "properties": {
          "start_line": {
            "type": "integer",
            "title": "Start Line"
          },
          "start_column": {
            "type": "integer",
            "title": "Start Column"
          },
          "end_line": {
            "type": "integer",
            "title": "End Line"
          },
          "end_column": {
            "type": "integer",
            "title": "End Column"
          },
          "start_offset": {
            "type": "integer",
            "title": "Start Offset"
          },
          "end_offset": {
            "type": "integer",
            "title": "End Offset"
          }
        },
        "type": "object",
        "required": [
          "start_line",
          "start_column",
          "end_line",
          "end_column",
          "start_offset",
          "end_offset"
        ],
        "title": "ErrorPosition",
        "description": "Where in the submitted SQL a failure is, for the editor to underline.\n\nA half-open range, in both conventions the editor might want, so the client does\nno arithmetic: 1-based `line`/`column` (what Monaco's IRange takes) and 0-based\n`offset` (what a plain string slice takes). They describe the same span.\n\nCoordinates index the SQL exactly as the caller submitted it — comments, line\nbreaks and all — not any normalised form of it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreateRequest": {
        "properties": {
          "sql_text": {
            "type": "string",
            "title": "Sql Text",
            "description": "SQL statement to execute"
          },
          "client_info": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Info",
            "description": "Client information, e.g. application name/version"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters",
            "description": "Values for any `:name` placeholders in sql_text, as key-value pairs. Values passed here always take priority. Any placeholder the query references that isn't included here is automatically resolved from the caller's saved variables (see the Variables API) - this is what lets a shared query stay generic (e.g. `WHERE department = :department`) while each caller's own saved value fills in without them passing it explicitly. A placeholder that's neither passed nor saved is left unresolved, and the job fails at execution with a parameter-not-defined error."
          }
        },
        "type": "object",
        "required": [
          "sql_text"
        ],
        "title": "JobCreateRequest",
        "example": {
          "client_info": {
            "app": "docs-try-it",
            "version": "1.0"
          },
          "sql_text": "SELECT customer_id, SUM(amount) AS total FROM sales GROUP BY customer_id ORDER BY total DESC LIMIT 10"
        }
      },
      "JobCreateResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current state of the job"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {}
            ],
            "title": "Created At"
          },
          "status_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Url"
          }
        },
        "type": "object",
        "required": [
          "execution_id",
          "status",
          "created_at"
        ],
        "title": "JobCreateResponse"
      },
      "JobResultsResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "error_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorPosition"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "sql_text": {
            "type": "string",
            "title": "Sql Text"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "bytes_processed": {
            "type": "integer",
            "title": "Bytes Processed",
            "default": 0
          },
          "time_taken_s": {
            "type": "number",
            "title": "Time Taken S",
            "default": 0
          },
          "time_planning_s": {
            "type": "number",
            "title": "Time Planning S",
            "default": 0
          },
          "time_executing_s": {
            "type": "number",
            "title": "Time Executing S",
            "default": 0
          },
          "engine_timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Engine Timings"
          },
          "io_scan_diagnostics": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Io Scan Diagnostics"
          },
          "sensor_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sensor Data"
