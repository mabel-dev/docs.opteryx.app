  "components": {
    "schemas": {
      "EstimateRequest": {
        "properties": {
          "sql_text": {
            "type": "string",
            "title": "Sql Text",
            "description": "SQL statement to estimate"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters",
            "description": "Values for any `:name` placeholders in sql_text. Resolved the same way as job creation's parameters field: explicit values here take priority, anything else the query references is resolved from the caller's saved variables (see the Variables API)."
          }
        },
        "type": "object",
        "required": [
          "sql_text"
        ],
        "title": "EstimateRequest",
        "example": {
          "sql_text": "SELECT * FROM sales WHERE order_date >= '2026-01-01'"
        }
      },
      "EstimateResponse": {
        "properties": {
          "bytes": {
            "type": "integer",
            "title": "Bytes",
            "description": "Estimated result size in bytes"
          }
        },
        "type": "object",
        "required": [
          "bytes"
        ],
        "title": "EstimateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCancelResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current state of the job"
          }
        },
        "type": "object",
        "required": [
          "execution_id",
          "cancelled",
          "status"
        ],
        "title": "JobCancelResponse"
      },
      "JobCreateRequest": {
        "properties": {
          "sql_text": {
            "type": "string",
            "title": "Sql Text",
            "description": "SQL statement to execute"
          },
          "client_info": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Info",
            "description": "Client information, e.g. application name/version"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters",
            "description": "Values for any `:name` placeholders in sql_text, as key-value pairs. Values passed here always take priority. Any placeholder the query references that isn't included here is automatically resolved from the caller's saved variables (see the Variables API) - this is what lets a shared query stay generic (e.g. `WHERE department = :department`) while each caller's own saved value fills in without them passing it explicitly. A placeholder that's neither passed nor saved is left unresolved, and the job fails at execution with a parameter-not-defined error."
          }
        },
        "type": "object",
        "required": [
          "sql_text"
        ],
        "title": "JobCreateRequest",
        "example": {
          "client_info": {
            "app": "docs-try-it",
            "version": "1.0"
          },
          "sql_text": "SELECT customer_id, SUM(amount) AS total FROM sales GROUP BY customer_id ORDER BY total DESC LIMIT 10"
        }
      },
      "JobCreateResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current state of the job"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {}
            ],
            "title": "Created At"
          },
          "status_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Url"
          }
        },
        "type": "object",
        "required": [
          "execution_id",
          "status",
          "created_at"
        ],
        "title": "JobCreateResponse"
      },
      "JobResultsResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "sql_text": {
            "type": "string",
            "title": "Sql Text"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "bytes_processed": {
            "type": "integer",
            "title": "Bytes Processed",
            "default": 0
          },
          "time_taken_s": {
            "type": "number",
            "title": "Time Taken S",
            "default": 0
          },
          "time_planning_s": {
            "type": "number",
            "title": "Time Planning S",
            "default": 0
          },
          "time_executing_s": {
            "type": "number",
            "title": "Time Executing S",
            "default": 0
          },
          "engine_timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Engine Timings"
          },
          "io_scan_diagnostics": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Io Scan Diagnostics"
          },
          "sensor_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sensor Data"
          },
          "edges": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Edges"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages"
          },
          "total_rows": {
            "type": "integer",
            "title": "Total Rows",
            "default": 0
          },
          "total_size_estimate": {
            "type": "integer",
            "title": "Total Size Estimate",
            "default": 0
          },
          "has_trace": {
            "type": "boolean",
            "title": "Has Trace",
            "default": false
          },
          "trace": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace"
          },
          "data": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Data"
          },
          "next_page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Page"
          }
        },
        "type": "object",
        "title": "JobResultsResponse"
      },
      "JobStatusResponse": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current state of the job"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {},
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "results_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Results Url"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "execution_id",
          "status"
        ],
        "title": "JobStatusResponse"
      },
      "QueryColumn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "QueryColumn"
      },
      "QueryJob": {
        "properties": {
