    "/clients/{client_id}/federated-credentials": {
      "post": {
        "tags": [
          "credentials"
        ],
        "summary": "Register Federated Credential",
        "description": "Register a workload as a credential-less credential.\n\nA GitHub Actions workflow, or a GCP service account, can then exchange the\nOIDC token its platform mints for it for an Opteryx access token at\n`/token`, with no stored client secret anywhere in the loop. The token it\nreceives is the one the `client_credentials` grant issues for this same\n`client_id` - same policies, same lifetime - so nothing downstream needs\nto change.\n\nThe workload must request the audience this service expects. A GitHub\nworkflow additionally needs `permissions: id-token: write`.\n\nCallers may register bindings for their own client_id (authenticated via\nbearer token) or, with an admin token, for any client_id.\n\nArgs:\n    client_id: Client the workload authenticates as\n    request: Binding parameters\n\nReturns:\n    The registered binding (there is no secret to return)",
        "operationId": "register_federated_credential_clients__client_id__federated_credentials_post",
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client identifier",
              "title": "Client Id"
            },
            "description": "Client identifier"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterFederatedCredentialRequest"
              }
            }
          }
        },
        "responses": {
