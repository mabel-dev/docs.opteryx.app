      "RegisterFederatedCredentialRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "The OIDC provider the workload authenticates with: 'github' or 'google'.",
            "default": "github"
          },
          "subject": {
            "type": "string",
            "title": "Subject",
            "description": "The provider's immutable identifier for the workload. For 'github', the numeric repository id (the `repository_id` claim) - not `owner/name`. For 'google', the service account's numeric unique id (its `sub` claim) - not its email. Names are recycled after a rename, transfer, or a delete and recreate; these ids are not."
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label",
            "description": "The readable name this id belongs to - `owner/name`, or the service account email. Recorded so a human reading the credential list can tell what it is; never used for matching."
          },
          "constraints": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Constraints",
            "description": "Claims to pin exactly, narrowing the binding further. For 'github': `job_workflow_ref` (one workflow file on one ref), `ref`, `environment`. For 'google': `email`. Pinning a claim the provider does not issue is rejected rather than silently never matching."
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience",
            "description": "Optional audience this binding additionally requires, for a deployment that accepts more than one."
          },
          "expires_in_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Days",
            "description": "Lifetime of the binding in days (max 365). Defaults to null - no secret is stored, so there is nothing to rotate."
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes",
            "description": "Scopes to grant the binding. Empty grants the caller's default scopes."
          },
          "permissions": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Permissions",
            "description": "Resource grants as [pattern, role] pairs, e.g. [['analytics.*', 'reader']]. Roles are 'owner', 'admin', 'writer' or 'reader'."
          }
        },
        "type": "object",
        "required": [
          "subject"
        ],
        "title": "RegisterFederatedCredentialRequest",
        "example": {
          "constraints": {
            "job_workflow_ref": "mabel-dev/opteryx-core/.github/workflows/scan.yaml@refs/heads/main"
          },
          "label": "mabel-dev/opteryx-core",
          "permissions": [
            [
              "security.*",
              "writer"
            ]
          ],
          "provider": "github",
          "scopes": [],
          "subject": "123456789"
        }
      },
      "RegisterFederatedCredentialResponse": {
        "properties": {
          "client_id": {
            "type": "string",
