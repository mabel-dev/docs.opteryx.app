    "/clients/{client_id}/credentials": {
      "post": {
        "tags": [
          "credentials"
        ],
        "summary": "Create Credential",
        "description": "Create a new client credential (PAT).\n\nThis creates a Personal Access Token (PAT) for machine-to-machine authentication.\nThe secret is shown only once and must be stored securely by the caller.\n\nCallers may create credentials for their own client_id (authenticated via bearer\ntoken) or, with an admin token, for any client_id.\n\nArgs:\n    client_id: Client identifier\n    request: Credential creation parameters\n\nReturns:\n    Credential metadata with plaintext secret (shown only once)",
        "operationId": "create_credential_clients__client_id__credentials_post",
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Client identifier",
              "title": "Client Id"
            },
            "description": "Client identifier"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCredentialRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCredentialResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
