            "title": "Permissions",
            "description": "Resource grants as [pattern, role] pairs, e.g. [['analytics.*', 'reader']]. Roles are 'owner', 'admin', 'writer' or 'reader'."
          }
        },
        "type": "object",
        "title": "CreateCredentialRequest",
        "example": {
          "expires_in_days": 90,
          "permissions": [
            [
              "analytics.*",
              "reader"
            ]
          ],
          "scopes": [],
          "type": "interactive"
        }
      },
